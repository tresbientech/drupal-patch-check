{
    "name": "tresbientech/drupatch",
    "description": "Drupal Code Query Composer plugin: says which of a site's composer patches still apply after an update, and which are already fixed upstream.",
    "license": "MIT",
    "type": "composer-plugin",
    "keywords": [
        "drupal",
        "composer-plugin",
        "patches",
        "upgrade"
    ],
    "authors": [
        {
            "name": "Théodore Biadala",
            "homepage": "https://tresbien.tech"
        }
    ],
    "homepage": "https://github.com/tresbientech/drupatch",
    "support": {
        "issues": "https://github.com/tresbientech/drupatch/issues",
        "source": "https://github.com/tresbientech/drupatch"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.2",
        "ergebnis/composer-normalize": "^2.52",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "TresBienTech\\Drupatch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TresBienTech\\Drupatch\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "class": "TresBienTech\\Drupatch\\Plugin"
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "qa": [
            "@cs:check",
            "@stan",
            "@test"
        ],
        "stan": "phpstan analyse",
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "cs": "Apply the formatting rules",
        "qa": "Formatting, static analysis and tests: the check to run before claiming done"
    }
}
